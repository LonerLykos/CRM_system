        {
          "name": "Export Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Async-гілка (count > EXPORT_SYNC_MAX_ROWS) повертає 202 {task_id} —",
                  "// зберігаємо його у змінну колекції для Export Status / Export Download.",
                  "if (pm.response.code === 202) {",
                  "    const json = pm.response.json();",
                  "    if (json.task_id) {",
                  "        pm.collectionVariables.set('task_id', json.task_id);",
                  "        console.log('Saved task_id =', json.task_id);",
                  "    }",
                  "} else if (pm.response.code === 200) {",
                  "    console.log('Sync-гілка: xlsx повернуто напряму (count <= EXPORT_SYNC_MAX_ROWS).');",
                  "}"
                ]
              }
            }
