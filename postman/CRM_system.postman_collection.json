  "item": [
    {
      "name": "Auth",
      "description": "Ендпоінти автентифікації. JWT передається через httpOnly cookie (access_token / refresh_token). Middleware бекенду автоматично читає cookie і кладе у Authorization-заголовок.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth",
              "host": ["{{base_url}}"],
              "path": ["auth"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Логін за email і паролем. Повертає access_token і refresh_token у тілі відповіді та встановлює однойменні httpOnly cookies."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Оновлення access-токена. refresh_token береться з httpOnly cookie (тіло не потрібне). При ротації токенів (ROTATE_REFRESH_TOKENS=True) повертає нову пару токенів і оновлює cookies."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Вихід із системи. Заносить refresh-токен (із cookie) у blacklist і видаляє cookies access_token/refresh_token. Тіло не потрібне."
          },
          "response": []
        },
        {
          "name": "Current User (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Повертає дані поточного авторизованого користувача."
          },
          "response": []
        }
      ]
    },
