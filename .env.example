# Django
SECRET_KEY=            # секретний ключ Django (згенеруй власний, напр. get_random_secret_key())
DEBUG=False            # True лише локально; на проді завжди False

# JWT (RS256) — base64 від PEM-ключів. Згенеруй пару й закодуй: base64 -w0 private.pem
JWT_PRIVATE_KEY_B64=   # приватний ключ у base64
JWT_PUBLIC_KEY_B64=    # публічний ключ у base64

# MySQL
MYSQL_USER=            # користувач БД
MYSQL_PASSWORD=        # пароль користувача БД
MYSQL_DATABASE=        # назва бази
MYSQL_HOST=            # хост БД (у docker — назва сервісу або зовнішній IP)
MYSQL_PORT=3306        # порт MySQL (дефолт 3306)

# Redis — брокер і result backend для Celery (експорт замовлень)
REDIS_URL=redis://redis:6379/0   # у docker host = назва сервісу 'redis'; локально без docker — redis://localhost:6379/0

# Порти, що публікуються на хост
BACKEND_PORT=8000      # порт бекенду (gunicorn)
FRONTEND_PORT=3000     # порт фронтенду (Next.js)

# URL-и
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000   # публічний URL фронта (CORS/посилання)
INTERNAL_API_URL=http://crm:8000                 # внутрішній URL бекенду для SSR-запитів фронта
